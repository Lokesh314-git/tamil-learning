rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && (
        request.auth.token.role == 'admin' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Student / User profiles
    match /users/{userId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isAdmin();
    }

    // Academic content (Units, Materials, Tests, Tasks, Announcements, Downloads, etc.)
    match /departments/{id} { allow read: if true; allow write: if true; }
    match /classes/{id} { allow read: if true; allow write: if true; }
    match /units/{id} { allow read: if true; allow write: if true; }
    match /studyMaterials/{id} { allow read: if true; allow write: if true; }
    match /study_materials/{id} { allow read: if true; allow write: if true; }
    match /tests/{id} { allow read: if true; allow write: if true; }
    match /publishedTests/{id} { allow read: if true; allow write: if true; }
    match /quizzes/{id} { allow read: if true; allow write: if true; }
    match /tasks/{id} { allow read: if true; allow write: if true; }
    match /assignments/{id} { allow read: if true; allow write: if true; }
    match /announcements/{id} { allow read: if true; allow write: if true; }
    match /thirukkurals/{id} { allow read: if true; allow write: if true; }
    match /downloads/{id} { allow read: if true; allow write: if true; }
    match /notifications/{id} { allow read: if true; allow write: if true; }
    match /settings/{id} { allow read: if true; allow write: if true; }

    // Student interactive collections
    match /attendance/{id} { allow read, write: if true; }
    match /results/{id} { allow read, write: if true; }
    match /testResults/{id} { allow read, write: if true; }
    match /reports/{id} { allow read, write: if true; }
    match /notes/{id} { allow read, write: if true; }
    match /task_submissions/{id} { allow read, write: if true; }
    match /taskSubmissions/{id} { allow read, write: if true; }
    match /assignmentSubmissions/{id} { allow read, write: if true; }
    match /feedback/{id} { allow read, write: if true; }
    match /student_preferences/{id} { allow read, write: if true; }
    match /preferences/{id} { allow read, write: if true; }
    match /documents/{id} { allow read, write: if true; }
    match /mongo_file_chunks/{id} { allow read, write: if true; }
    match /mongo_sync_queue/{id} { allow read, write: if true; }
    match /logs/{id} { allow read, write: if true; }
    match /auditLogs/{id} { allow read, write: if true; }

    match /{document=**} { allow read, write: if true; }
  }
}
