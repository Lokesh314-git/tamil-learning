rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =============================================================
    // Helper Functions
    // =============================================================

    // User is genuinely authenticated with Firebase Authentication
    function signedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    // User has Administrator privileges (via Auth custom claims, root email, or users doc)
    function isAdmin() {
      return signedIn() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.admin == true ||
        (request.auth.token.email != null && request.auth.token.email == 'tamillearning2024@gmail.com') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // =============================================================
    // 1. User Profiles & Accounts (Admins & Students)
    // 100% Spark Plan compatible: allows read for student verification
    // =============================================================
    match /users/{userId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if true;
    }

    // =============================================================
    // 2. Academic Curriculum & Course Structure
    // Read open to students; write restricted to Administrators
    // =============================================================
    match /departments/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /classes/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /units/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /study_materials/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /studyMaterials/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /downloads/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /thirukkurals/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /documents/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =============================================================
    // 3. Tests, Quizzes & Assessments
    // =============================================================
    // Master tests with answer keys are restricted to Admins only
    match /tests/{id} {
      allow read, write: if isAdmin();
    }

    // Published tests (student-safe assessment questions without answer keys)
    match /publishedTests/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /quizzes/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =============================================================
    // 4. Test Results & Reports
    // =============================================================
    match /results/{id} {
      allow read, write: if true;
    }
    match /testResults/{id} {
      allow read, write: if true;
    }
    match /reports/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =============================================================
    // 5. Tasks, Assignments & Homework Submissions
    // =============================================================
    match /tasks/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /assignments/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /task_submissions/{id} {
      allow read, write: if true;
    }
    match /taskSubmissions/{id} {
      allow read, write: if true;
    }
    match /submissions/{id} {
      allow read, write: if true;
    }
    match /assignmentSubmissions/{id} {
      allow read, write: if true;
    }

    // =============================================================
    // 6. Communications, Notices & Alerts
    // =============================================================
    match /announcements/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /notices/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /notifications/{id} {
      allow read, write: if true;
    }
    match /feedback/{id} {
      allow read, write: if true;
    }

    // =============================================================
    // 7. Student Interactive & Personal Data
    // =============================================================
    match /attendance/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /attendance_records/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /student_attendance/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /notes/{id} {
      allow read, write: if true;
    }
    match /student_preferences/{id} {
      allow read, write: if true;
    }
    match /preferences/{id} {
      allow read, write: if true;
    }

    // =============================================================
    // 8. Storage, Sync & Diagnostics (Admin only)
    // =============================================================
    match /mongo_file_chunks/{id} { allow read, write: if isAdmin(); }
    match /mongo_sync_queue/{id} { allow read, write: if isAdmin(); }
    match /logs/{id} { allow read, write: if isAdmin(); }
    match /auditLogs/{id} { allow read, write: if isAdmin(); }
    match /audit_logs/{id} { allow read, write: if isAdmin(); }
    match /login_attempts/{id} { allow read, write: if isAdmin(); }

    // Fallback: Default access for all other documents
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
