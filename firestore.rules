rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && (
        request.auth.token.role == 'admin' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }
    function isStudent() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'student' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isDeleted != true &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status != 'blocked' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status != 'rejected' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status != 'deleted' &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isApproved == true ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.approved == true ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active');
    }
    function ownsStudentRecord() {
      return signedIn() && resource.data.studentId == request.auth.uid;
    }
    function writesOwnStudentRecord() {
      return isStudent() && request.resource.data.studentId == request.auth.uid;
    }

    // Students cannot read or modify lookup credentials; administrators can maintain them.
    match /studentLookup/{identifier} { allow read, write: if isAdmin(); }
    match /{collectionName}/{studentId} {
      allow read, write: if collectionName == 'students data' && isAdmin();
    }

    match /users/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow create: if isAdmin() || (signedIn() && request.auth.uid == userId &&
        request.resource.data.role == 'student' && request.resource.data.status == 'pending');
      allow update: if isAdmin() || (isStudent() && request.auth.uid == userId &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.isApproved == resource.data.isApproved &&
        request.resource.data.approved == resource.data.approved &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.isDeleted == resource.data.isDeleted);
      allow delete: if isAdmin();
    }

    // Authenticated students can read assigned academic content. Writes are admin-only.
    match /departments/{id} { allow read: if isStudent() || isAdmin(); allow write: if isAdmin(); }
    match /classes/{id} { allow read: if isStudent() || isAdmin(); allow write: if isAdmin(); }
    match /units/{id} { allow read: if isStudent() || isAdmin(); allow write: if isAdmin(); }
    match /studyMaterials/{id} { allow read: if isStudent() || isAdmin(); allow write: if isAdmin(); }
    match /study_materials/{id} { allow read: if isStudent() || isAdmin(); allow write: if isAdmin(); }
    match /tests/{id} { allow read, write: if isAdmin(); }
    match /publishedTests/{id} { allow read: if isStudent() || isAdmin(); allow write: if isAdmin(); }
    match /quizzes/{id} { allow read: if isStudent() || isAdmin(); allow write: if isAdmin(); }
    match /tasks/{id} { allow read: if isStudent() || isAdmin(); allow write: if isAdmin(); }
    match /assignments/{id} { allow read: if isStudent() || isAdmin(); allow write: if isAdmin(); }
    match /announcements/{id} { allow read: if isStudent() || isAdmin(); allow write: if isAdmin(); }
    match /thirukkurals/{id} { allow read: if isStudent() || isAdmin(); allow write: if isAdmin(); }
    match /downloads/{id} { allow read: if isStudent() || isAdmin(); allow write: if isAdmin(); }

    // Student generated data is scoped by studentId; admins manage and review it.
    match /attendance/{id} {
      allow read: if isAdmin() || ownsStudentRecord();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }
    match /results/{id} {
      allow read: if isAdmin() || ownsStudentRecord();
      allow write: if isAdmin();
    }
    match /testResults/{id} {
      allow read: if isAdmin() || ownsStudentRecord();
      allow write: if isAdmin();
    }
    match /reports/{id} {
      allow read: if isAdmin() || ownsStudentRecord();
      allow write: if isAdmin();
    }
    match /notes/{id} {
      allow read: if isAdmin() || ownsStudentRecord();
      allow create: if isAdmin() || writesOwnStudentRecord();
      allow update: if isAdmin() || (ownsStudentRecord() && writesOwnStudentRecord());
      allow delete: if isAdmin() || ownsStudentRecord();
    }
    match /task_submissions/{id} {
      allow read: if isAdmin() || ownsStudentRecord();
      allow create, update: if isAdmin() || writesOwnStudentRecord();
      allow delete: if isAdmin();
    }
    match /taskSubmissions/{id} {
      allow read: if isAdmin() || ownsStudentRecord();
      allow create, update: if isAdmin() || writesOwnStudentRecord();
      allow delete: if isAdmin();
    }
    match /assignmentSubmissions/{id} {
      allow read: if isAdmin() || ownsStudentRecord();
      allow write: if isAdmin() || writesOwnStudentRecord();
    }
    match /feedback/{id} {
      allow read: if isAdmin() || ownsStudentRecord();
      allow create: if isAdmin() || writesOwnStudentRecord();
      allow update, delete: if isAdmin();
    }
    match /notifications/{id} { allow read: if isStudent() || isAdmin(); allow write: if isAdmin(); }
    match /settings/{id} { allow read: if isAdmin() || (isStudent() && id == 'features'); allow write: if isAdmin(); }
    match /mongo_file_chunks/{id} { allow read: if isStudent() || isAdmin(); allow write: if isAdmin(); }
    match /mongo_sync_queue/{id} { allow read, write: if isAdmin(); }
    match /logs/{id} { allow read, write: if isAdmin(); }
    match /auditLogs/{id} { allow read, write: if isAdmin(); }
    match /{document=**} { allow read, write: if false; }
  }
}
